{
  "name": "agent-demo",
  "version": "0.1.0",
  "private": true,
  "description": "An AI agent that answers questions about my work by calling tools on my GitHub.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "data": "node scripts/build-data.ts",
    "build": "npm run data && node scripts/build-web.ts",
    "test": "npm run data && vitest run",
    "check": "npm run data && tsc --noEmit && vitest run",
    "dev": "npm run data && wrangler dev",
    "deploy": "npm run data && wrangler deploy",
    "summarize-private": "node scripts/summarize-private.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
